doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_login.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        title Login
    body
        include components/mixin.pug
        +bubble()
        div#login
            h2 Log-in to your account
            form(action="/login", method="POST")
                div
                    label(for="email") E-mail
                    input.form-text#email(type="text", name="email", placeholder="mail@example.com", required)
                div
                    label(for="password") Password
                    input.form-text#password(type="password", name="password", placeholder="Your password", required)
                div
                    button#valider-small(type="submit") Login
            p First time here? #[a#account(href="/register") Create an account]