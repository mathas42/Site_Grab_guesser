doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        title Login
    body
        section.wrapper
            div.bulle: img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
            div.bulle: img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
            div.bulle: img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
            div.bulle: img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
            div.bulle: img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
            div.bulle: img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
            div.bulle: img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
            div.bulle: img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
            div.bulle: img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
            div.bulle: img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon

        div#login
            h2 Login
            form(action="/login", method="POST")
                div
                    label(for="email") E-mail:
                    input(type="text", name="email", required)
                div
                    label(for="password") Password:
                    input(type="password", name="password", required)
                div
                    button(type="submit") Login