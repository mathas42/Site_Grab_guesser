doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_login.css")
        link(rel="icon", type="image/png", href="/images/Logo_Grab_Food_Guesser.png")
        title Login
    body
        section.wrapper
            div.bubble: img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
            div.bubble: img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
            div.bubble: img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
            div.bubble: img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
            div.bubble: img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
            div.bubble: img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
            div.bubble: img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
            div.bubble: img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
            div.bubble: img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
            div.bubble: img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon

        div#login
            h2 Log-in to your account
            form(action="/login", method="POST")
                div
                    label(for="email") E-mail
                    input.form-text#email(type="text", name="email", required)
                div
                    label(for="password") Password
                    input.form-text#password(type="password", name="password", required)
                div
                    button#valider-small(type="submit") Login
            p First time here? #[a(href="/register") Create an account]