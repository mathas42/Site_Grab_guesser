doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_admin.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        script(src="/js/notification.js" defer)
        script(src="/js/script.js" defer)
        script(src="/js/admin.js" defer)
        title Grab Food Guesser - Admin

    body#admin.bg-grab
        include components/nav.pug
        include components/notification.pug
        include components/mixin.pug
        div#title_div.flex-center
            h1#title Admin panel
        +welcome(user.nickname, false)
        div#screen.flex-center
            details#user-data-section(open)
                summary
                    h3.small-margin User Data
                
                form#search
                    input#search-input(type="search", name="search", placeholder="Username or ID")
                    button#search-button(type="submit") Search

                div#table-wrap
                    table#user-data
                        colgroup
                            col.col-modify
                            col.col-id
                            col.col-role
                            col.col-username
                            col.col-email
                            col.col-created
                            col.col-change-role
                            col.col-change-nickname
                            col.col-delete
                            col.col-confirm
                        thead
                            tr
                                th Modify
                                th ID
                                th Role
                                th Username
                                th Email
                                th Created
                                th Change Role
                                th Change nickname 
                                th Delete User
                                th Confirm changes
                        tbody#users

            details#add-dish-section
                summary
                    h3 Add a Dish
                div#add-dish
                    form#upload-form(data-category="dishes")
                        label.field
                            span.label Dish name
                            input(type="text", name="nom", placeholder="e.g. Chicken Rice", maxlength="255", required)

                        label.field
                            span.label Restaurant
                            input(type="text", name="nom_restaurant", placeholder="e.g. Nasi Kandar Pelita", maxlength="255", required)

                        label.field
                            span.label Price
                            span.input-prefix
                                span.prefix RM
                                input(type="number", name="prix", placeholder="0.00", min="0.01", step="0.01", required)

                        label.field
                            span.label Image
                            input#myFile(type="file", name="image", accept="image/png,image/jpeg,image/webp", required)

                        label.field.full
                            span.label Description
                                span.optional  (optional)
                            textarea(name="description", placeholder="A few words about the dish...", rows="3")

                        button.new#submit-dish.full(type="submit") Add dish
        include components/footer.pug