doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_admin.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        script(src="/js/script.js" defer)
        script(src="/js/profil.js")
        script(src="/js/admin.js" defer)
        title Grab Food Guesser - Admin

    body#admin.bg-grab
        include components/nav.pug
        include components/notification.pug
        div#title_div.flex-center
            h1#title Grab Food Guesser !
        if user
            h2#welcome Welcome #{user.nickname}    
        div#screen.flex-center
            h2 Admin panel

            div 
            form#search
                input#search-input(type="search", name="search", placeholder="Username or ID")
                button(type="submit") Search
            
            table#user-data
                thead
                    tr
                        th Modify
                        th ID
                        th Role
                        th Username
                        th Email
                        th Created
                        th Change Role
                        th Change nickname 
                        th Delete User
                        th Confirm changes
                tbody#users
        include components/footer.pug