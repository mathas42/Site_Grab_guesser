doctype html
html(lang="fr")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="icon", type="image/png", href="/images/Logo_Grab_Food_Guesser.png")
        title Jeu

    body
        div#info.flex-center
            h2 Score : 
                span#score 0
            h2 Round : 
                span#round 1/5

        div#list.flex-center
            #products-list
        
        div#val.flex-center
            span#value 20.00 RM 4.30 Euro

        div#rep.flex-center
            div.annonce
            button#lesslessless(onpointerdown="startModify(-1)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") -1
            button#lessless(onpointerdown="startModify(-0.1)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") -0.1
            button#less(onpointerdown="startModify(-0.01)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") -0.01
            input#reponse(type="range" min="0" max="40" value="20" step="0.01")
            button#more(onpointerdown="startModify(0.01)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") +0.01
            button#moremore(onpointerdown="startModify(0.1)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") +0.1
            button#moremoremore(onpointerdown="startModify(1)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") +1
        div#reveal2.flex-center
            div.annonce222
        div#reveal.flex-center
            p.annonce22
            div.annonce2
        div#sec
            legend Hint
            div#secret_center
                div#secret.flex-center
                    button#hint(onclick="hint()" data-info="Informs you if the price is more or less of your guess") More or Less : 2
                    p.hint1

                div#secret2.flex-center
                    button#temperature(onclick="temperature()"  data-info="Informs you if your guess is near (hot) or far (cold) from the price") Temperature : 2
                    p.hint2

        div#valid.flex-center
            button.next-class#valider(onclick="valider()") Validate

        div.modal#modal
                div.modal-content
                    p#modal-text Congratulations! You have found the right price!😎
                    button#close-modal(onclick="closeModal()") Close    
        
        div#reveal3.flex-center
            p.annonce3

        div#reveal4.flex-center
            p.annonce4

        div#reveal5.flex-center
            .following

        script(src="/js/change.js")
        script(src="/js/script.js")