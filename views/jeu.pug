doctype html
html(lang="fr")
    head
        meta(charset="UTF-8")
        link(rel="stylesheet", href="/css/style.css")
        title Jeu

    body
        div#info
            h2 Score : 
                span#score 0
            h2 Round :
                span#round 1/5

        div#liste
            #liste-produits
        
        div#val
            span#value 20.00 RM 4.30 Euro

        div#rep
            div.annonce Votre réponse :
            button#moinsmoins(onpointerdown="startModify(-0.1)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") - -
            button#moins(onpointerdown="startModify(-0.01)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") -
            input#reponse(type="range" min="0" max="40" value="20" step="0.01")
            button#plus(onpointerdown="startModify(0.01)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") +
            button#plusplus(onpointerdown="startModify(0.1)" onpointerup="stopModify()" onpointerleave="stopModify()" onpointercancel="stopModify()") + +
        div#reveal2
            div.annonce222
        div#reveal
            p.annonce22
            div.annonce2
        div#secret
            button#hint(onclick="hint()") More or Less : 2
            p.hint1

        div#secret2
            button#temperature(onclick="temperature()") Temperature : 2
            p.hint2

        div#valid
            button#valider(onclick="valider()") Validate

        div.modal#modal
                div.modal-content
                    p#modal-text Congratulations! You have find the right price!😎
                    button#close-modal(onclick="closeModal()") Close    

        script(src="/js/script.js")
        
        div#reveal3
            p.annonce3

        div#reveal4
            p.annonce4

        div#reveal5
            .suivant