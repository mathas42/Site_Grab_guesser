doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="icon", type="image/png", href="/images/Logo_Grab_Food_Guesser.png")
        script(src="/js/script.js" defer)
        script(src="/js/profil.js")
        title Grab Food Guesser

    body#index
        div#title_div.flex-center
            h1#title Grab Food Guesser !
        if user
            h2#welcome Welcome #{user.nickname}
                img.avatar-profil(src=user.avatar, alt="Avatar de " + user.nickname, data-nickname=user.nickname, onclick="ProfilePopup()")
        
        div#screen.flex-center
            button.new(onclick="new_play()",) Play
            button.new(onclick="new_learn_()") Learn
        div#screen.flex-center
            button.new#new2(onclick="new_hard()") Hard Mode
            form(action="/logout", method="post", style="display:contents")
                button.new#new3(type="submit") Log-out
        div#screen.flex-center
            button.new#new3(type="button",onclick="window.location.href='/profil'") Edit Profile
        div.notification
            img(src="/images/Logo_Grab_Food_Guesser.png")
            div.details
                div.name
                div.message
            span.btn(onclick="closeNotification()") x
        img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
        img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
        img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
        img(src="/images/icons/food-fruit-fruits-18-svgrepo-com.svg", alt="Fruit").icon
        img(src="/images/icons/food-color-coffee-long-svgrepo-com.svg", alt="Chinese food").icon

        div#tutorial
            div#tutorial-content
                div#tutorial-body
                    div.question
                        h2.title Welcome to Grab Food Guesser!
                        p In this game, you will be presented with a series of food-related questions. Your goal is to guess the correct answer based on the clues provided. Good luck and have fun!*
                    div.question
                        h2.title How to Play ?
                        p Welcome to Grab Food Guesser! In this game, you will be presented with a series of food-related questions. Your goal is to guess the correct answer based on the clues provided. Good luck and have fun!
                    div.question
                        h2.title Tips and Tricks
                        p To improve your chances of winning, pay close attention to the clues provided and think critically about the possible answers. Don't be afraid to take risks and make educated guesses. Remember, practice makes perfect!
                    div.question
                        h2.title Scoring and Rewards
                        p In Grab Food Guesser, you will earn points for each correct answer. The more points you accumulate, the higher your score will be. You can also earn rewards and unlock new levels as you progress through the game. Keep playing to see how high you can score!

        footer
            div#footer-content
                div#infos
                    p.title Infos
                    div.block
                        a(href="/about") About
                        a(href="/contact") Contact 
                        a(href="/terms") Terms of Service
                        a(href="/privacy") Privacy Policy
                div#path 
                    p.title Path
                    div.block
                        a(href="/") Home
                        a(href="/profil") Profile
                        a(href="/learn") Learn
                        a(href="/play") Play
                div#socials
                    p.title Socials
                    div.block
                        a(href="https://www.instagram.com/") Instagram
                        a(href="https://www.facebook.com/") Facebook
                        a(href="https://twitter.com/") Twitter
                        a(href="https://www.linkedin.com/") LinkedIn

            p © 2026 Grab Food Guesser MLMGTG. All rights reserved.