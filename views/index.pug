doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="icon", type="image/png", href="/images/grab_logo.png")
        script(src="/js/script.js" defer)
        script(src="/js/profil.js")
        title Grab Food Guesser

    body#index
        include components/mixin.pug
        div#title_div.flex-center
            h1#title Grab Food Guesser !
        if user
            h2#welcome Welcome #{user.nickname}
                img.avatar-profil(src=user.avatar, alt="Avatar de " + user.nickname, data-nickname=user.nickname, onclick="ProfilePopup()")
        
        div#screen.flex-center
            button.new(onclick="new_play()",) Play
            button.new(onclick="new_learn_()") Learn
        div#screen.flex-center
            button.new#new2(onclick="new_hard()") Hard Mode
            form(action="/logout", method="post", style="display:contents")
                button.new#new3(type="submit") Log-out
        +button("Edit Profile", "window.location.href='/profil'", "new", "new3 ")
        include components/notification.pug
        img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
        img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
        img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
        img(src="/images/icons/food-fruit-fruits-18-svgrepo-com.svg", alt="Fruit").icon
        img(src="/images/icons/food-color-coffee-long-svgrepo-com.svg", alt="Chinese food").icon

        div#tutorial
            div#tutorial-content
                div#tutorial-body
                    +question("Welcome to Grab Food Guesser!", "In this game, you will be presented with a series of food-related questions. Your goal is to guess the correct answer based on the clues provided. Good luck and have fun!")
                    +question("How to Play ?", "Pick a dish, then move the slider to guess its price in RM. The closer you are, the more points you earn.")
                    +question("Tips and Tricks", "Use the More or Less and Temperature hints wisely: you only get a few per round.")
                    +question("Scoring and Rewards", "You earn up to 4 points per round. The more points you accumulate, the higher your score will be.")
                    +question("Ready to Play?", "Click the \"Play\" button to start the game and test your food knowledge!")
        include components/footer.pug