doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="icon", type="image/png", href="/images/Logo_Grab_Food_Guesser.png")
        script(src="/js/script.js" defer)
        script(src="/js/profil.js")
        title Grab Food Guesser

    body#index
        div#title_div.flex-center
            h1#title Grab Food Guesser !
        if user
            h2#welcome Welcome #{user.nickname}
                img.avatar-profil(src=user.avatar, alt="Avatar de " + user.nickname, data-nickname=user.nickname, onclick="ProfilePopup()")
        
        div#screen.flex-center
            button.new(onclick="new_play()") Play
            button.new(onclick="new_learn_()") Learn
        div#screen.flex-center
            button.new#new2(onclick="new_hard()") Hard Mode
            form(action="/logout", method="post", style="display:contents")
                button.new#new3(type="submit") Log-out
        div#screen.flex-center
            button.new#new3(type="button",onclick="window.location.href='/profil'") Edit Profil

        img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
        img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
        img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
        img(src="/images/icons/food-fruit-fruits-18-svgrepo-com.svg", alt="Fruit").icon
        img(src="/images/icons/food-color-coffee-long-svgrepo-com.svg", alt="Chinese food").icon


        footer
            p © 2026 Grab Food Guesser MLMGTG. All rights reserved.