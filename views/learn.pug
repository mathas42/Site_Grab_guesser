doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Learn about Malaysian Food
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_learn.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")

    body.bg-grab
        header#header_learn
            h1 Learn about Malaysian Food
            input#research(type="search", placeholder="Search a dish...", aria-label="Search a dish")
            button#valider-white(type="button",onclick="window.location.href='/index'") Home

        main
            div#catalogue
            p#counter 
            button#see-more(type="button" hidden) More

        include components/footer.pug

        script(src="/js/change.js" defer)
        script(src="/js/learn_script.js" defer)
        script(src="/js/script.js" defer)