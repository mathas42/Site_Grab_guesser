doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Learn Malaysian Food
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_learn.css")
        link(rel="icon", type="image/svg+xml", href="/images/icons/chinese-food-svgrepo-com.svg")

    body
