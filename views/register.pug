doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_profil.css")
        link(rel="stylesheet", href="/css/style_login.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        script(src="/js/notification.js", defer)
        script(src="/js/flash.js", defer)
        script(src="/js/register.js", defer)
        title Register
    body
        include components/notification.pug 
        include components/mixin.pug
        +bubble()
        a#home-link(href="/", aria-label="Back to home")
            img(src="/images/nav/home-svgrepo-com.svg", alt="")
            span Home

        div#regist
            h2 Register
            form#form-profil2(action="/register", method="POST", novalidate)
                div 
                    h3 Select your avatar

                    div#avatar-div-actuel
                        img#avatar-actuel(
                            src=avatar
                            alt="Avatar actuel"
                        )

                    #galerie-avatars
                        each image in avatars
                            button.avatar-option(
                                type="button"
                                data-avatar=image
                                class= image === avatar ? "selectionne" : ""
                            )
                                img(src=image, alt="Choisir cet avatar")
                div
                    label(for="name") Name 
                    input#name.form-text(type="text" name="name" placeholder="ex: Mathias" size="32" minlength="3" maxlength="30" autocomplete="nickname" required)
                div
                    label(for="email") E-mail 
                    input#email.form-text(type="email" name="email" placeholder="ex: mathias@example.com" size="32" minlength="6" maxlength="64" autocomplete="email" required)
                div
                    label(for="password") Password 
                    input#password.form-text(type="password" name="password" placeholder="ex: 1234" size="32" minlength="8" maxlength="64" autocomplete="new-password" required)
                div
                    button#valider-small(type="submit") Register 
            p Already a user? #[a#log-in(href="/login") Log-in]