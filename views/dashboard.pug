doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        script(src="/js/notification.js" defer)
        script(src="/js/script.js" defer)
        script(src="/js/profil.js")
        title Grab Food Guesser

    body#index
        include components/mixin.pug
        include components/nav.pug
        include components/notification.pug
        div#background
            div#title_div.flex-center
                h1#title Grab Food Guesser !
            div#screen.flex-center
                +button("Play","new_play()","new","")
                +button("Hard Mode","new_hard()","new","new2")
            img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
            img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
            img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
            img(src="/images/icons/food-fruit-fruits-18-svgrepo-com.svg", alt="Fruit").icon
            img(src="/images/icons/food-color-coffee-long-svgrepo-com.svg", alt="Chinese food").icon

        div#tutorial
            div#tutorial-content
                div#tutorial-body
                    +question("","", "Welcome to Grab Food Guesser!", "The aim of our project is to help users discover Malaysian cuisine through an interactive price-guessing game. Each dish is presented with a description to help users learn more about Malaysian food and its culinary culture. Players must guess the price of each dish and compare their estimates with the actual prices. Through this game, users can explore local specialties, discover new dishes, and learn more about Malaysian cuisine in an entertaining and engaging way.")
                    +question("1","number", "How to Play ?", "Pick a dish, then move the slider to guess its price in RM. The closer you are, the more points you earn.")
                    +question("2","number", "Tips and Tricks", "Use the More or Less and Temperature hints wisely: you only get a few per round.")
                    +question("3","number", "Scoring and Rewards", "You earn up to 4 points per round. The more points you accumulate, the higher your score will be.")
                    +question("4","number", "Ready to Play?", "Click the \"Play\" button to start the game and test your food knowledge!")
        include components/footer.pug