doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        script(src="/js/notification.js" defer)
        script(src="/js/script.js" defer)
        title Grab Food Guesser

    body#index
        include components/mixin.pug
        include components/nav.pug
        include components/notification.pug
        div#background
            div.flex-center
                h1#title Grab Food Guesser !
            div#screen.flex-center
                +button("Play","new_play()","new","")
                +button("Hard Mode","new_hard()","new","new2")
            img(src="/images/icons/chinese-food-svgrepo-com.svg", alt="Chinese food").icon
            img(src="/images/icons/food-pack-box-with-handle-svgrepo-com.svg", alt="Food pack").icon
            img(src="/images/icons/restaurant-paper-svgrepo-com.svg", alt="Restaurant paper").icon
            img(src="/images/icons/food-fruit-fruits-18-svgrepo-com.svg", alt="Fruit").icon
            img(src="/images/icons/food-color-coffee-long-svgrepo-com.svg", alt="Chinese food").icon

            section#stats
                - const s = locals.stats || {}
                - const card1 = s.best_score != null ? s.best_score : "–"
                +card("","Best score",card1,"")
                - const card2 =s.best_hard_score != null ? s.best_hard_score : "–"
                +card("","Hard mode",card2,"")
                - const card3 = s.best_score != null ? "#" + s.normal_rank : "–"
                +card("", "Rank", card3, "")

        div#tutorial
            div#tutorial-content
                div#tutorial-body
                    +question("","", "Welcome to Grab Food Guesser!", "The aim of our project is to help you discover Malaysian cuisine through a price-guessing game. Guess each dish's price, compare it with the real one, and learn about local specialties along the way.")
                    +question("1","number", "Tips and Tricks", "Use the More or Less and Temperature hints wisely: you only get a few per round.")
                    +question("2","number", "Scoring and Rewards", "You earn up to 4 points per round. The more points you accumulate, the higher your score will be.")
        include components/footer.pug