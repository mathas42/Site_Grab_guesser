doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="/css/style_pre_index.css")
        link(rel="stylesheet", href="/css/style.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        script(src="/js/notification.js", defer)
        script(src="/js/flash.js", defer)
        script(src="/js/script.js" defer)
        title Grab Food Guesser

    body#index
        include components/mixin.pug
        include components/nav.pug
        include components/notification.pug
        div#background
            div.flex-center
                h1#title Grab Food Guesser !
            div#screen.flex-center
                +game_mode("/images/tut/tofu-soup.jpg", "Enjoy the game peacefully.", "5 Rounds  4 Hints", "normal_mode", "Play Normal","new_play()")
                +game_mode("/images/tut/mapo-tofu.jpg", "Only for trained players !", "7 Rounds  2 Hints and Malus points", "hardcore_mode", "Play Hard mode","new_hard()")

            section#stats
                - const s = locals.stats || {}
                - const card1 = s.best_score != null ? s.best_score : "–"
                +card("","Best score",card1,"")
                - const card2 =s.best_hard_score != null ? s.best_hard_score : "–"
                +card("","Hard mode",card2,"")
                - const card3 = s.best_score != null ? "#" + s.normal_rank : "–"
                +card("", "Rank", card3, "")

        div#tutorial
            div#tutorial-content
                div#tutorial-body
                    +question("","", "Guess the price. Taste Malaysia!", "Spot a dish, guess its price in RM, and see how close you get. Every round teaches you something new about Malaysian food.")
                    +question("1","number", "Use your hints wisely", "More or Less and Temperature can save you, but you only get a few per round. Don't waste them!")
                    +question("2","number", "Score big", "Up to 4 points per round. Guess closer, earn more, and climb the ranking.")
                    div.flex-center
                        button.next-class(type="button", onclick="window.location.href='/hall_of_fame'") Explore the Leaderboard
        include components/footer.pug