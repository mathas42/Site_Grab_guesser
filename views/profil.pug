doctype html
html(lang="fr")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title My profil
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_profil.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        script(src="/js/profil.js", defer)
        script(src="/js/script.js")

    body
        main.profil-container
            h1 My profile

            form#form-profil
                label(for="nickname") My nickname
                input#nickname(
                    type="text"
                    name="nickname"
                    value=nickname
                    maxlength="30"
                    required
                )

                h2 Select my avatar
                div#avatar-div-actuel
                    img#avatar-actuel(
                        src=avatar
                        alt="Avatar actuel"
                    )

                #galerie-avatars
                    each image in avatars
                        button.avatar-option(
                            type="button"
                            data-avatar=image
                            class= image === avatar ? "selectionne" : ""
                        )
                            img(src=image, alt="Choisir cet avatar")

                
                button.new#enregistrer-profil(type="submit") Apply
                div.notification
                    img(src="/images/Logo_Grab_Food_Guesser.png")
                    div.details
                        div.name
                        div.message
                    span.btn(onclick="closeNotification()") x

                p#message-profil(aria-live="polite")

            button#valider-white(type="button",onclick="window.location.href='/index'") Home
