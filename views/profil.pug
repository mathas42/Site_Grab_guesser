doctype html
html(lang="fr")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title My profil
        link(rel="stylesheet", href="/css/style.css")
        link(rel="stylesheet", href="/css/style_profil.css")
        link(rel="icon", type="image/png", href="/images/logo_loupe.png")
        script(src="/js/profil.js", defer)
        script(src="/js/notification.js")
        script(src="/js/script.js")

    body
        include components/notification.pug
        main.profil-container
            h1 My profile

            form#form-profil
                label(for="nickname") My nickname
                input#nickname(
                    type="text"
                    name="nickname"
                    value=nickname
                    maxlength="30"
                    required
                )

                h2 Select my avatar
                div#avatar-div-actuel
                    img#avatar-actuel(
                        src=avatar
                        alt="Avatar actuel"
                    )

                #galerie-avatars
                    each image in avatars
                        button.avatar-option(
                            type="button"
                            data-avatar=image
                            class= image === avatar ? "selectionne" : ""
                        )
                            img(src=image, alt="Choisir cet avatar")

                details#password-section
                    summary Change my password (optional)
                    div
                        label(for="current-password") Current password
                        input#current-password.form-text(type="password", autocomplete="current-password")
                    div
                        label(for="new-password") New password
                        input#new-password.form-text(type="password", autocomplete="new-password", minlength="8", maxlength="64")
                    div
                        label(for="confirm-password") Confirm new password
                        input#confirm-password.form-text(type="password", autocomplete="new-password")

                
                
                button.new#enregistrer-profil(type="submit") Apply
                p#message-profil(aria-live="polite")

