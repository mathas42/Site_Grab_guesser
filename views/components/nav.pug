link(rel="stylesheet", href="/css/style_nav.css")
nav#main-nav
    a#nav-logo-link(href="/")
        img#nav-logo(src="/images/grab_logo.png", alt="Grab logo")
    div#nav-container
        a(href="/") Home
        a(href="/jeu", onclick="new_play()") Play
        a(href="/learn") Learn
        a(href="/index") Index
        if isAdmin
            a(href="/admin") Admin
    div#nav-container2
        if user
            img.avatar-profil(src=user.avatar, alt="Avatar de " + user.nickname, data-nickname=user.nickname, onclick="ProfilePopup()")
            span#user-name= user.nickname
        else
            a(href="/login")
                img.nav-svg#nav-login(src="/images/nav/user-svgrepo-com.svg", alt="Login")
        img.nav-svg#nav-hamburger(src="/images/nav/hamburger-svgrepo-com.svg", alt="Menu", onclick="toggleNav()")

    script(src="/js/nav.js" defer)