mixin card(title)
    section.card
        h2= title
        block

mixin button(text, onclick, className, id)
    button(onclick=onclick, class=className, id=id)= text

mixin question(number, className, title, content)
    if number
        div(class=className)= number
    div.question
        h2.title= title
        p= content

mixin welcome(userName = user && user.nickname, showAvatar = true)
    if user
        div.flex-line
            h2.welcome.small-margin Welcome #{userName}
            if showAvatar
                img.avatar-profil(src=user.avatar, alt="Avatar de " + userName, onclick="window.location.href = '/dashboard/profil'")

mixin card(number, label, value, path)
    div.stat-card
        if number
            div.number= number
        span.stat-label= label
        span.stat-value= value
        if path
            img.img-card(src=path)

mixin game_mode(path, text, id, buttonText,gamePath)
    div.mode-container
        img(src=path)
        div.collum
            p= text
            button.next-class(type="button", id=id, onclick=gamePath)= buttonText

mixin bubble()
    - const foods = ["/images/icons/chinese-food-svgrepo-com.svg", "/images/icons/food-color-coffee-long-svgrepo-com.svg", "/images/icons/food-fruit-fruits-18-svgrepo-com.svg", "/images/icons/food-pack-box-with-handle-svgrepo-com.svg", "/images/icons/restaurant-paper-svgrepo-com.svg"]
    - const all = foods.concat(foods.slice().reverse())
    div.wrapper(aria-hidden="true")
        each food in all
            div.bubble
                img.icon(src=food, alt="")
                span.dot