mixin card(title)
    section.card
        h2= title
        block

mixin button(text, onclick, className, id)
    button(onclick=onclick, class=className, id=id)= text

mixin question(number, className, title, content)
    if number
        div(class=className)= number
    div.question
        h2.title= title
        p= content

mixin welcome(userName = user && user.nickname, showAvatar = true)
    if user
        div.flex-line
            h2.welcome.small-margin Welcome #{userName}
            if showAvatar
                img.avatar-profil(src=user.avatar, alt="Avatar de " + userName, onclick="window.location.href = '/dashboard/profil'")